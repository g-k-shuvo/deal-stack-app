# ---- App ----
# 32-byte key used to encrypt the firm's Anthropic API key at rest.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Default Claude model (per-skill overridable in skill config). Confirm against current model list.
DEFAULT_CLAUDE_MODEL=claude-opus-4-8

# ---- Data backend ----
# Default (unset/0): seeded in-memory repo. Set to 1 to use Supabase (needs migration+seed applied).
USE_SUPABASE=0
# Set to 1 to enforce Supabase auth (middleware redirects to /login). Default off (single-user dev).
USE_SUPABASE_AUTH=0
# Force the deterministic mock generator regardless of key. Default: live if a key is set, else mock.
DCC_AI_MODE=mock

# ---- Supabase (local dev defaults from `npx supabase start`) ----
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Testing ----
# Set to 1 to run the gated live Anthropic smoke tests (excluded from default CI).
RUN_LIVE_AI=0

# NOTE: the firm's Anthropic API key is NOT an env var — it is stored encrypted at
# runtime (see lib/crypto + Settings). Only APP_ENCRYPTION_KEY lives in the environment.

# ---- Database & Auth (Neon & Better Auth) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

